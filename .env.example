# LinkedIn API Credentials
# These can be placed here or passed directly in the 'env' section of mcp_config.json

# OAuth 2.0 Access Token (Required for publishing)
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# User or Organization URN (e.g. urn:li:person:XXXXX or urn:li:organization:XXXXX)
# Optional: Auto-discovered from /v2/userinfo if not provided
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here

# Developer App Credentials (Used by setup_auth.py)
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# Custom SQLite Database Path (Optional, defaults to ~/.linkedin_post_manager/linkedin_posts.db)
# LINKEDIN_DB_PATH=d:/MCP/Linkedin-post-manager/data/posts.db
